<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проект для конкурса стратегий: .NET 10, один класс, без NuGet-пакетов.
    Единственная зависимость — контракты из task.md. SkipMaster.Contracts заменяет контракты раннера;
    при сдаче эта ссылка указывает на сборку с контрактами, которую даст раннер.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SkipMaster.Contracts\SkipMaster.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
